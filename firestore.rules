rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────────────
    // PRODUCTION RULES (uncomment when Firebase Auth is enabled)
    // ──────────────────────────────────────────────────────
    // function isAdmin() {
    //   return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    // }
    // function isOwner(recruiterId) {
    //   return request.auth != null && request.auth.uid == recruiterId;
    // }
    //
    // match /users/{userId} {
    //   allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
    //   allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    // }
    // match /users/{userId}/creditAuditLog/{logId} {
    //   allow read: if request.auth != null && isAdmin();
    //   allow write: if false; // Only Cloud Functions write audit logs
    // }
    // match /assessments/{assessmentId} {
    //   allow read: if true; // Candidates need to read assessment metadata
    //   allow write: if request.auth != null;
    // }
    // match /candidates/{candidateId} {
    //   allow read: if request.auth != null && (isOwner(resource.data.recruiterId) || isAdmin());
    //   allow delete: if request.auth != null && (isOwner(resource.data.recruiterId) || isAdmin());
    //   allow create, update: if false; // Only Cloud Functions write candidate results
    // }
    // match /sessions/{sessionId} {
    //   allow read: if true;
    //   allow update: if request.resource.data.sessionToken == resource.data.sessionToken
    //                 && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['keys', 'createdAt', 'assessmentId', 'sessionToken']);
    //   allow create, delete: if false; // Only Cloud Functions manage sessions
    // }

    // ──────────────────────────────────────────────────────
    // DEV/DEMO RULES (active — remove for production)
    // Allows anonymous access for demo/emulator mode
    // ──────────────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if true;
    }
    match /users/{userId}/creditAuditLog/{logId} {
      allow read, write: if true;
    }
    match /assessments/{assessmentId} {
      allow read: if true;
      allow write: if true;
    }
    match /candidates/{candidateId} {
      allow read: if true;
      allow delete: if true;
      allow write: if true;
    }
    match /sessions/{sessionId} {
      allow read: if true;
      allow update: if request.resource.data.sessionToken == resource.data.sessionToken
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['keys', 'createdAt', 'assessmentId', 'sessionToken']);
    }
  }
}
