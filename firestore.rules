rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────────────────────
    // PRODUCTION RULES
    //
    // Principles:
    //  * Every WRITE/DELETE that mutates product data goes through Cloud
    //    Functions callables (admin SDK, bypasses these rules). Clients get
    //    no anonymous write/delete anywhere.
    //  * READS stay anonymous because the UI has no Firebase Auth yet
    //    (demo phase): the recruiter dashboard and owner admin load
    //    candidates/users directly from the client. Tightening reads to
    //    authenticated owners/admins requires wiring Firebase Auth — see
    //    the helpers below (isAdmin/isOwner) which are ready to enable.
    //
    // Auth helper functions:
    function isAdmin() {
      return request.auth != null
        && (request.auth.token.admin == true
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
            // Legacy pre-migration layout: the owner's profile doc is keyed by the
            // old localStorage ID (users/owner_prokopios) and links the auth UID via
            // the `authUid` field (see scripts/bootstrap-admin.mjs).
            || get(/databases/$(database)/documents/users/owner_prokopios).data.authUid == request.auth.uid);
    }
    function isOwner(recruiterId) {
      return request.auth != null && request.auth.uid == recruiterId;
    }
    // ──────────────────────────────────────────────────────────────

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || resource.data.authUid == request.auth.uid || isAdmin());
      allow write: if false; // only Cloud Functions manage users/credits/audit logs
    }
    match /users/{userId}/creditAuditLog/{logId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if false; // only Cloud Functions write audit logs
    }

    match /assessments/{assessmentId} {
      allow read: if true; // candidates need to read assessment metadata
      allow write: if false; // only Cloud Functions create assessments
    }

    match /candidates/{candidateId} {
      allow read: if isOwner(resource.data.recruiterId) || isAdmin();
      allow create, update, delete: if false;
    }


    match /sessions/{sessionId} {
      // Sessions are server-managed (startSession creates them, submitAssessment
      // deletes them, /api/integrity appends events). The candidate test page
      // persists progress in localStorage and submits via callables.
      allow read, create, update, delete: if false;
    }
  }
}
